{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "v2: OL eta+LR sweep (smoke)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_v2.py",
      "args": [
        "run",
        "-c",
        "tmp/lr_plot_test/config.yaml",
        "--goal",
        "online_learning",
        "--sweep",
        "1d",
        "--axis",
        "eta",
        "--lr-sweep",
        "-m",
        "experiments/results/base_model_random_data_snr_10_SubspaceNet_esprit_N9_M3_SNR10.0_Far_ESPRIT/checkpoints/final_SubspaceNet_20250916_084930.pt",
        "-o",
        "tmp/lr_plot_test/run_debug"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "v2: train only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_v2.py",
