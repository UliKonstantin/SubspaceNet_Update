        "-c",
        "tests/configs/test_training.yaml",
        "--goal",
        "train",
        "-o",
        "tmp/debug_train"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "v2: evaluate single",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_v2.py",
      "args": [
        "run",
        "-c",
        "tests/configs/test_training.yaml",
        "--goal",
        "evaluate",
        "-m",
        "experiments/results/base_model_random_data_snr_10_SubspaceNet_esprit_N9_M3_SNR10.0_Far_ESPRIT/checkpoints/final_SubspaceNet_20250916_084930.pt",
        "-o",
